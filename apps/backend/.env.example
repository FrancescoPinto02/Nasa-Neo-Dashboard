APP_ENV=local
APP_DEBUG=true

LOG_LEVEL=INFO
LOG_JSON=false

NASA_API_KEY=DEMO_KEY
NASA_NEOWS_BASE_URL=https://api.nasa.gov/neo/rest/v1
NASA_REQUEST_TIMEOUT_SECONDS=10

NASA_MAX_CHUNK_DAYS=7
APP_MAX_QUERY_RANGE_DAYS=90

CACHE_BACKEND=disk
CACHE_TTL_SECONDS=21600
CACHE_DISK_DIRECTORY=.cache/nasa-neo

REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS='["http://localhost:3000"]'